---
layout: layouts/base.njk
title: Gallery
description: Photos from past trips with Milena.
---
{%- from "macros.njk" import photo with context -%}

<section class="page-head">
  <div class="wrap">
    <h1>Gallery</h1>
    <p class="lead">Snapshots from our trips together.{% if gallery.length %} Tap or click any photo to see it bigger.{% endif %}</p>
  </div>
</section>

<section class="section section-white">
  <div class="wrap">
    {%- if gallery.length or site.draft %}
    <ul class="gallery">
      {%- if gallery.length %}
      {%- for item in gallery %}
      <li>
        <figure>
          <a class="js-lightbox" href="{{ item.src }}" data-caption="{{ item.caption }}">
            <div class="photo"><img src="{{ item.src }}" alt="{{ item.alt }}" loading="lazy"></div>
          </a>
          <figcaption>{{ item.caption }}</figcaption>
        </figure>
      </li>
      {%- endfor %}
      {%- else %}
      {%- for i in range(9) %}
      <li>
        <figure>
          {{ photo("", "", "a past trip") }}
          <figcaption>{% ph "Place, Year" %}</figcaption>
        </figure>
      </li>
      {%- endfor %}
      {%- endif %}
    </ul>
    {%- else %}
    <p class="lead">Photos from past trips are on their way. Check back soon!</p>
    {%- endif %}
  </div>
</section>
