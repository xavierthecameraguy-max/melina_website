<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.url == "/" %}{{ site.name }}: {{ site.tagline }}{% else %}{{ title }} | {{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  {%- if site.draft or past %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  <meta name="theme-color" content="{{ theme.themeColor }}">
  <meta property="og:title" content="{{ title if page.url != '/' else site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  {%- if site.url %}
  <meta property="og:url" content="{{ page.url | htmlBaseUrl(site.url) }}">
  {%- if image %}
  <meta property="og:image" content="{{ image | htmlBaseUrl(site.url) }}">
  {%- endif %}
  {%- endif %}
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  {%- for font in theme.preload %}
  <link rel="preload" href="/assets/fonts/{{ font }}" as="font" type="font/woff2" crossorigin>
  {%- endfor %}
  <link rel="stylesheet" href="/assets/css/site.css">
  <link rel="stylesheet" href="/assets/themes/{{ theme.id }}/theme.css">
  <script>document.documentElement.classList.add("js");</script>
  <script src="/assets/js/site.js" defer></script>
</head>
<body class="theme-{{ theme.id }}">
  <a class="skip-link" href="#main">Skip to main content</a>
  {%- if demo %}
  <nav class="demo-bar" aria-label="Design preview">
    <div class="wrap">
      <p>Previewing the <strong>{{ theme.label }}</strong> design</p>
      <ul>
        <li><a href="{{ demo.home }}{{ demo.prev.id }}{{ page.url }}" title="{{ demo.prev.label }}"><span aria-hidden="true">←</span> Previous<span class="demo-long"> design</span></a></li>
        <li><a href="{{ demo.home }}">All designs</a></li>
        <li><a href="{{ demo.home }}{{ demo.next.id }}{{ page.url }}" title="{{ demo.next.label }}">Next<span class="demo-long"> design</span> <span aria-hidden="true">→</span></a></li>
      </ul>
    </div>
  </nav>
  {%- endif %}
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
