  <div class="form-actions">
    <button class="btn btn-primary" type="submit">{{ submitLabel }}</button>
    <p>Rather talk? {% if site.phone %}<a href="{{ site.phone | telHref }}">Call me at <span class="nowrap">{{ site.phone }}</span></a>{% else %}Call me at {% ph "phone" %}{% endif %}</p>
  </div>
  {%- if submitNote %}
  <p class="form-note">{{ submitNote }}</p>
  {%- endif %}
  {%- if not site.web3formsAccessKey %}
  <p class="form-note">This opens your email app with your answers, addressed to {{ site.owner }} and ready to send.</p>
  {%- endif %}
</form>
