{#- Opening of every form. Set `formSubject` and `thanksPath` before including. Submissions go to Web3Forms
    (free; the access key in site.json decides which inbox gets them). Until there's a key, the form opens the
    visitor's email app with their answers written out to site.email, so every form still reaches Milena. -#}
<form class="js-form"
  {%- if site.web3formsAccessKey %} action="https://api.web3forms.com/submit" method="POST"
  {%- else %} action="mailto:{{ site.email }}?subject={{ formSubject | urlencode }}" method="POST" enctype="text/plain"
  {%- endif %}
  data-thanks="{{ thanksPath | htmlBaseUrl }}"
  data-connected="{{ 'yes' if site.web3formsAccessKey else 'no' }}"
  data-mailto="{{ site.email }}">
  <div class="form-alert" tabindex="-1" hidden></div>
  <input type="hidden" name="access_key" value="{{ site.web3formsAccessKey }}">
  <input type="hidden" name="subject" value="{{ formSubject }}">
  <input type="hidden" name="from_name" value="{{ site.name }} website">
  {%- if site.url %}
  <input type="hidden" name="redirect" value="{{ thanksPath | htmlBaseUrl(site.url) }}">
  {%- endif %}
  <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" aria-hidden="true">
