{%- from "macros.njk" import textField, textArea, radios -%}
{%- set formSubject = "New message from the website" -%}
{%- set submitLabel = "Send message" -%}
{%- set submitNote = "" -%}
{% include "partials/form-open.njk" %}
  {{ textField("m-name", "Name", required=true, autocomplete="name") }}
  {{ textField("m-phone", "Phone", type="tel", required=true, autocomplete="tel") }}
  {{ textField("m-email", "Email", type="email", autocomplete="email") }}
  {{ radios("m-reach", "Best way to reach you", ["Call", "Text", "Email"], inline=true) }}
  {{ textArea("m-message", "Message", required=true) }}
{% include "partials/form-actions.njk" %}
