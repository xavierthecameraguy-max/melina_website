<section class="section">
  <div class="wrap measure">
    <h1>Thank you!</h1>
    <p class="lead">Your note is on its way to me. I'll get back to you {% if site.replyTime %}{{ site.replyTime }}{% else %}{% ph "within X days" %}{% endif %}.</p>
    <p>If it's urgent, {% if site.phone %}<a href="{{ site.phone | telHref }}">call me at {{ site.phone }}</a>{% else %}call me at {% ph "phone" %}{% endif %}.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/services/#upcoming-trips">See upcoming trips</a>
      <a class="btn btn-sun" href="/">Back to home</a>
    </div>
  </div>
</section>
